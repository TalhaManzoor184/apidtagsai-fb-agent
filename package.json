{
  "name": "rapidtagsai-fb-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Autonomous Facebook Page poster for rapidtagsai.com (SEO + hashtag content with images)",
  "scripts": {
    "start": "tsx src/index.ts",
    "dry": "cross-env DRY_RUN=true tsx src/index.ts",
    "mock": "cross-env DRY_RUN=true MOCK_LLM=true tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "post": "cross-env DRY_RUN=false tsx src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "dotenv": "^18.0.8",
    "satori": "^0.63.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

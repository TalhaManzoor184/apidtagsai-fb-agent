# Text generation: anthropic | gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Image: template (branded card, free) | gemini (AI background + branded overlay, needs GEMINI_API_KEY)
IMAGE_MODE=template
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Facebook Page
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v26.0

# Content
SITE_URL=https://rapidtagsai.com
BRAND_NAME=RapidTagsAI
POST_LANGUAGE=English
# POST_LANGUAGE=Roman Urdu mixed with English

# Local testing
DRY_RUN=true
MOCK_LLM=false
